#!/bin/sh
set -e

# Dedicated unprivileged service account (never run the gateway as root).
if ! getent group aegis >/dev/null 2>&1; then
    addgroup --system aegis >/dev/null
fi
if ! getent passwd aegis >/dev/null 2>&1; then
    adduser --system --ingroup aegis --home /var/lib/aegis-ics --no-create-home \
        --shell /usr/sbin/nologin aegis >/dev/null
fi
adduser aegis dialout >/dev/null 2>&1 || true

# Data and log directories owned by the service account, not world-readable
# (they hold the database, device keys and the generated admin password).
mkdir -p /var/lib/aegis-ics /var/log/aegis-ics
chown aegis:aegis /var/lib/aegis-ics /var/log/aegis-ics
chmod 750 /var/lib/aegis-ics /var/log/aegis-ics

# Site configuration file for secrets (readable by root and the service group only).
if [ ! -f /etc/default/aegis-ics ]; then
    cat > /etc/default/aegis-ics <<'EOF'
# Aegis ICS site configuration (sourced by the systemd unit and the SysV init script).
# ADMIN_PASSWORD=<at least 12 characters>   # otherwise a random one is generated on first start
# FLASK_SECRET_KEY=<64 hex chars>
# FLASK_SESSION_SECURE=true                 # when served through an HTTPS reverse proxy
# AEGIS_DEVICE_KEYS_FILE=/var/lib/aegis-ics/device_keys.json
EOF
    chown root:aegis /etc/default/aegis-ics
    chmod 640 /etc/default/aegis-ics
fi

# Setup symlink in /usr/local/bin
if [ -x /opt/aegis-ics/AegisICS ]; then
    ln -sf /opt/aegis-ics/AegisICS /usr/local/bin/aegis-ics
    chmod +x /opt/aegis-ics/AegisICS
fi

# Install SysVinit script if init.d exists (standard in MX Linux)
if [ -d /etc/init.d ] && [ -f /opt/aegis-ics/aegis-ics.init ]; then
    cp /opt/aegis-ics/aegis-ics.init /etc/init.d/aegis-ics
    chmod 755 /etc/init.d/aegis-ics
fi

# Update desktop and icon databases if tools are available
if which update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi
if which gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q /usr/share/icons/hicolor || true
fi

# Output guidance on hardware serial port access (dialout group)
echo "=================================================================="
echo " Aegis ICS successfully installed!"
echo " "
echo " Desktop GUI Mode : Run 'aegis-ics' or launch from Application Menu"
echo " Headless Server  : Run 'aegis-ics --server --port 5000'"
echo " Service (SysV)   : sudo service aegis-ics start (MX Linux default)"
echo " Service (systemd): sudo systemctl start aegis-ics"
echo " "
echo " Service listens on 127.0.0.1:5000 as user 'aegis'."
echo " First start: the admin password is printed to the service log and saved to"
echo "   /var/lib/aegis-ics/initial_admin_password.txt (or set ADMIN_PASSWORD in"
echo "   /etc/default/aegis-ics). Provision device keys before connecting hardware."
echo " "
echo " [NOTE] To allow access to USB/Serial COM devices (ESP32/PLC):"
echo "        Ensure your user is in the 'dialout' group:"
echo "        sudo usermod -a -G dialout \$USER"
echo "=================================================================="

exit 0
