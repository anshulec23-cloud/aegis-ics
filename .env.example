# Aegis ICS configuration. The application does NOT load this file automatically:
# export the variables, use your IDE's env-file support, or (Debian) put them in
# /etc/default/aegis-ics. Full reference: docs/04-development/configuration.md

# --- Accounts & sessions -------------------------------------------------------
# Optional: password for the 'admin' account (min. 12 characters). If unset, the app
# shows a first-run setup screen to create it (the desktop app opens it automatically).
ADMIN_PASSWORD=
# Session-cookie signing key (64 hex chars). If unset, <data dir>/.aegis_session_key is generated.
FLASK_SECRET_KEY=
# Set to true when served through an HTTPS reverse proxy.
FLASK_SESSION_SECURE=false

# --- Field devices ------------------------------------------------------------------
# Devices enroll themselves: approve them on the dashboard (Station 06). Nothing to set.
# Number of slaves emulated by the software simulator:
AEGIS_SIM_DEVICES=4
# Legacy v0 firmware only (compiled-in pre-shared keys):
# DEVICE_KEY_ESP32_001=
# AEGIS_DEVICE_KEYS_FILE=

# --- Gateway ---------------------------------------------------------------------
# Shared secret between serial_gateway.py and /api/telemetry. Only needed when the
# gateway runs as a separate process; the in-process gateway uses a random token.
AEGIS_GATEWAY_TOKEN=
# Seconds a queued command stays valid before it is dropped (default 5).
AEGIS_COMMAND_TTL_S=5

# --- Storage -----------------------------------------------------------------------
# AEGIS_DATA_DIR=/var/lib/aegis-ics
# DATABASE_URL=sqlite:////var/lib/aegis-ics/aegis_v2.db
